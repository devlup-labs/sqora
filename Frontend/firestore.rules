rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic security rule ensuring anyone who is signed in can read/write their own user document
    // and read basic structure if necessary
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Fallback block everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
