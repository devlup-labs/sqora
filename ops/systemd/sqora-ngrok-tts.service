[Unit]
Description=SQORA ngrok Tunnel (TTS)
After=network-online.target headtts.service
Wants=network-online.target headtts.service

[Service]
Type=simple
WorkingDirectory=/home/raid/sqora/sqora
EnvironmentFile=/home/raid/sqora/sqora/.env.tunnel
ExecStart=/bin/sh -lc 'if [ -n "${NGROK_TTS_DOMAIN:-}" ]; then exec "${NGROK_BIN:-/home/raid/.local/bin/ngrok}" http --domain "${NGROK_TTS_DOMAIN}" 8882; else exec "${NGROK_BIN:-/home/raid/.local/bin/ngrok}" http 8882; fi'
Restart=always
RestartSec=5
TimeoutStopSec=20
StandardOutput=append:/home/raid/sqora/sqora/ngrok-tts.log
StandardError=append:/home/raid/sqora/sqora/ngrok-tts.log

[Install]
WantedBy=default.target